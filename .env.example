# APPWRITE — required at runtime for authentication and persisted application data
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=
# Server-only. Never expose this value with NEXT_PUBLIC_ in production.
APPWRITE_API_KEY=
COLLECTION_USERS=users
COLLECTION_QUERIES=queries
COLLECTION_SNAPSHOTS=snapshots
COLLECTION_FEEDBACK=feedback
COLLECTION_ANALYTICS=analytics
COLLECTION_NOTIFICATIONS=notifications
COLLECTION_API_USAGE=api_usage
NEXT_PUBLIC_COLLECTION_ACCESS_LOGS=access_logs
NEXT_PUBLIC_COLLECTION_SETTINGS=settings

# EXA — normally stored per user through Settings; optional as a deployment default
EXA_API_KEY=

# EVALUATION — required to persist frozen benchmarks, judgments, and runs
COLLECTION_EVALUATION_DATASETS=evaluation_datasets
COLLECTION_EVALUATION_QUERIES=evaluation_queries
COLLECTION_RELEVANCE_JUDGMENTS=relevance_judgments
COLLECTION_EVALUATION_RUNS=evaluation_runs
COLLECTION_EVALUATION_RUN_QUERIES=evaluation_run_queries

# STAGE TRACE — required only for trace capture and stage diagnosis
COLLECTION_EVALUATION_STAGE_TRACES=evaluation_stage_traces
COLLECTION_EVALUATION_STAGE_TRACE_DOCUMENTS=evaluation_stage_trace_documents

# STRATEGY BENCHMARK — required only for Strategy Lab persistence
COLLECTION_EVALUATION_STRATEGIES=evaluation_strategies
COLLECTION_EVALUATION_STRATEGY_EXECUTIONS=evaluation_strategy_executions
COLLECTION_EVALUATION_STRATEGY_EXECUTION_DOCUMENTS=evaluation_strategy_execution_documents

# CACHE / OPTIONAL VECTOR ANALYTICS
COLLECTION_EMBEDDING_CACHE=embedding_cache
WEAVIATE_URL=
WEAVIATE_API_KEY=

# OPTIONAL EMBEDDINGS — only needed by semantic/vector analysis routes
GEMINI_API_KEY=
OPENAI_API_KEY=

# OPTIONAL RERANKING — no native provider is required by Strategy Lab imports
COHERE_API_KEY=

# OPTIONAL NOTIFICATIONS / SCHEDULING / DEPLOYMENT
RESEND_API_KEY=
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
